diff --git a/src/device.cpp b/src/device.cpp
index 45130c2..8bc63ae 100644
--- a/src/device.cpp
+++ b/src/device.cpp
@@ -42,6 +42,11 @@ REXCVAR_DEFINE_STRING(native_x_renderer_present_mode, "", "NativeXRenderer",
                       "\"mailbox\" = MAILBOX, else FIFO; \"immediate\" = IMMEDIATE (tearing, or a variable refresh "
                       "rate display following the game), else MAILBOX. FIFO where the driver offers none of them");
 
+REXCVAR_DEFINE_BOOL(native_x_renderer_allow_old_amd_driver, false, "NativeXRenderer",
+                    "Draw on an AMD GPU whose Vulkan driver is older than Vulkan 1.3 (the legacy drivers of GCN 1 and 2, "
+                    "such as the Radeon R7 M260's 2022 driver), whose shader compiler crashed on the game's shaders "
+                    "(amdvlk64.dll, re-wor 2026-11-18); off, the Xenos path draws there");
+
 REXCVAR_DEFINE_BOOL(native_x_renderer_dynamic_rendering, true, "NativeXRenderer",
                     "Draw with Vulkan's dynamic rendering (VK_KHR_dynamic_rendering, core in 1.3) where the device has "
                     "it, without render pass objects (D130): a pipeline names its targets' formats only, the first "
@@ -276,6 +281,14 @@ bool Device::Create(void* native_window, bool half_precision, uint32_t compile_t
           max_viewport_[i] = properties.limits.maxViewportDimensions[i];
         }
       }
+      if (properties.vendorID == 0x1002 && properties.apiVersion < VK_API_VERSION_1_3 &&
+          !REXCVAR_GET(native_x_renderer_allow_old_amd_driver)) {
+        REXLOG_ERROR("[native_x_renderer] {} has an old AMD Vulkan driver (API {}.{}.{}), whose shader compiler crashes "
+                     "on the game's shaders (native_x_renderer_allow_old_amd_driver tries it anyway)",
+                     properties.deviceName, VK_API_VERSION_MAJOR(properties.apiVersion),
+                     VK_API_VERSION_MINOR(properties.apiVersion), VK_API_VERSION_PATCH(properties.apiVersion));
+        return false;
+      }
     }
 #endif
     REXLOG_INFO("[native_x_renderer] viewports up to {}x{} host pixels (D134)", max_viewport_[0], max_viewport_[1]);
diff --git a/src/sdk_cvars.cpp b/src/sdk_cvars.cpp
index b78cd4f..2f9f7a1 100644
--- a/src/sdk_cvars.cpp
+++ b/src/sdk_cvars.cpp
@@ -27,3 +27,13 @@ bool& FLAGS_gpu_allow_invalid_fetch_constants_storage_() {
   thread_local native_x_renderer::sdk::Forwarded<bool> forwarded;
   return forwarded.Get("gpu_allow_invalid_fetch_constants", false);
 }
+int32_t& FLAGS_gpu_debug_log_draws_storage_() {
+  thread_local native_x_renderer::sdk::Forwarded<int32_t> forwarded;
+  return forwarded.Get("gpu_debug_log_draws", 0);
+}
+
+// The SDK's own native GPU path (re-wor's SDK): it runs inside the GPU plugin, never with NativeXRenderer's copies of
+// the graphics code, which see it off.
+namespace rex::graphics {
+bool IsNativeRendererActive() { return false; }
+}  // namespace rex::graphics
