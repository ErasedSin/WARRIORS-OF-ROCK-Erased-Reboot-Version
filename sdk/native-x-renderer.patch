+// NativeXRenderer - the SDK's texture replacement (texture packs), which the texture cache (sdk_texture_cache.cpp) uses
+// in SDKs that have it, such as re-wor's. Compiled the same way as the cache: its cvars stay the plugin's.
+
+#include "sdk_cvars.h"
+
+#include NATIVE_X_RENDERER_SDK_TEXTURE_REPLACEMENT_CPP
