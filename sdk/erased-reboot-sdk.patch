index 9b9cf9e..4334e6f 100644
--- a/include/rex/system/kernel_state.h
+++ b/include/rex/system/kernel_state.h
@@ -200,6 +200,22 @@ class KernelState {
   xam::AppManager* app_manager() const { return app_manager_.get(); }
   xam::ContentManager* content_manager() const { return content_manager_.get(); }
   xam::UserProfile* user_profile() const { return user_profile_.get(); }
+  // The profile of user_index: with player_profiles, that player's own when
+  // they have one; otherwise player 1's (whose IsSignedIn tells the rest).
+  xam::UserProfile* user_profile(uint32_t user_index) const {
+    if (user_index >= 1 && user_index < 4 && player_profiles_[user_index]) {
+      return player_profiles_[user_index].get();
+    }
+    return user_profile_.get();
+  }
+  // The users signed in, one bit each (XN_SYS_SIGNINCHANGED's data).
+  uint32_t signed_in_mask() const {
+    uint32_t mask = 1u << user_profile_->signed_in_user();
+    for (uint32_t i = 1; i < 4; ++i) {
+      if (player_profiles_[i]) mask |= 1u << i;
+    }
+    return mask;
