+  // unlocks, rl_ach_frame has no per-frame work that needs the game's frame.
+  std::thread([] {
+    for (;;) {
+      rl_ach_frame();
+      std::this_thread::sleep_for(std::chrono::milliseconds(50));
+    }
+  }).detach();
