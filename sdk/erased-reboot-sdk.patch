+
+Kind DeviceKind(const DeviceInfo& device);
+
+bool Matches(const DeviceInfo& device, const PlayerDevice& want) {
+  switch (want.kind) {
+    case Kind::kXInput:
+      return device.xinput_slot >= 0 && uint32_t(device.xinput_slot) + 1 == want.number &&
+             device.raw_xinput != want.sdl;
+    case Kind::kHid:
+      return !device.synthetic && !device.raw_xinput && device.vendor == want.vendor &&
+             device.product == want.product;
+    default:
+      return !OtherReading(device) && DeviceKind(device) == want.kind;
+  }
