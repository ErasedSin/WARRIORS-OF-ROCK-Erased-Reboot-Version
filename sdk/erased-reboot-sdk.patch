+void ConnectRecompLauncher(AchievementManager& achievements) {
+  static bool connected = false;
+  if (connected) return;
+  connected = true;
+  for (const auto& a : achievements.ListAchievements()) {
+    rl_ach_native_define(a.id, a.label.c_str(), a.description.c_str(), a.gamerscore);
