+// AvSetMmThreadCharacteristicsW from avrt.dll, loaded when asked for.
+void RaiseAudioThreadPriority() {
+#ifdef _WIN32
+  if (!REXCVAR_GET(audio_thread_priority)) return;
+  HMODULE avrt = LoadLibraryW(L"avrt.dll");
+  if (!avrt) return;
+  using SetMm = HANDLE(WINAPI*)(LPCWSTR, LPDWORD);
+  auto set_mm = reinterpret_cast<SetMm>(GetProcAddress(avrt, "AvSetMmThreadCharacteristicsW"));
+  DWORD task = 0;
