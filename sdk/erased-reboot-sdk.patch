--- a/src/kernel/xboxkrnl/xboxkrnl_rtl.cpp
+++ b/src/kernel/xboxkrnl/xboxkrnl_rtl.cpp
@@ -13,8 +13,24 @@
 #pragma GCC diagnostic ignored "-Wunused-parameter"
 
 #include <algorithm>
+#include <chrono>
 #include <string>
 
+#if defined(_M_X64) || defined(__x86_64__)
+#include <immintrin.h>
+#endif
+
+#include <rex/cvar.h>
+
+// Guest locks are held for very short times, and a host thread that goes to
+// sleep on one costs far more (a kernel wait and a wake-up) than watching it
+// for a few microseconds: in songs the main thread and the job workers took
+// the same locks by turns and slept and woke each other tens of thousands of
+// times a second. 0 = only the spin count the title asked for.
+REXCVAR_DEFINE_INT32(critical_section_spin_us, 0, "Kernel",
+                     "Microseconds a thread watches a held critical section before it sleeps "
+                     "(0 = only the title's own spin count)");
+
 #include <rex/chrono/chrono_steady_cast.h>
 #include <rex/kernel/xboxkrnl/private.h>
 #include <rex/kernel/xboxkrnl/rtl.h>
@@ -397,6 +413,23 @@ void RtlEnterCriticalSection_entry(ppc_ptr_t<X_RTL_CRITICAL_SECTION> cs) {
     }
   }
 
+  const int32_t watch_us = REXCVAR_GET(critical_section_spin_us);
+  if (watch_us > 0) {
+    const auto until = std::chrono::steady_clock::now() + std::chrono::microseconds(watch_us);
+    do {
+      for (int i = 0; i < 32; ++i) {
+        if (cs->lock_count == -1 && rex::thread::atomic_cas(-1, 0, &cs->lock_count)) {
+          cs->owning_thread = cur_thread;
+          cs->recursion_count = 1;
+          return;
+        }
+#if defined(_M_X64) || defined(__x86_64__)
+        _mm_pause();
+#endif
+      }
+    } while (std::chrono::steady_clock::now() < until);
+  }
+
   if (rex::thread::atomic_inc(&cs->lock_count) != 0) {
     // Create a full waiter.
     xeKeWaitForSingleObject(reinterpret_cast<void*>(cs.host_address()), 8, 0, 0, nullptr);
