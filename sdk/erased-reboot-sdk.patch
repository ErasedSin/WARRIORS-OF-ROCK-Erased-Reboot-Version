+  if (IsGamepadAsGuitar(gamepad)) {
+    return XINPUT_DEVSUBTYPE_GUITAR;
+  }
   return SdlTypeToXInputSubType(SDL_GetJoystickType(SDL_GetGamepadJoystick(gamepad)),
                                 SDL_GetGamepadName(gamepad));
 }
 
+bool IsGuitarSubType(uint8_t s) {
+  return s == XINPUT_DEVSUBTYPE_GUITAR || s == XINPUT_DEVSUBTYPE_GUITAR_ALTERNATE ||
+         s == XINPUT_DEVSUBTYPE_GUITAR_BASS;
+}
+
+#ifdef _WIN32
+// SDL reports the three XInput guitar kinds (guitar, alternate guitar, bass) as
+// one, so every guitar reached the guest as the plain kind, and Guitar Hero
+// guitars (alternate) lost their tilt. A guitar's kind and its tilt (right stick
+// Y) are read straight from XInput, at the slot SDL found it in.
+struct XInputPadRaw {
+  uint16_t buttons;
+  uint8_t left_trigger, right_trigger;
+  int16_t lx, ly, rx, ry;
+};
+struct XInputStateRaw {
+  uint32_t packet;
+  XInputPadRaw pad;
+};
+struct XInputCapsRaw {
+  uint8_t type, sub_type;
+  uint16_t flags;
+  XInputPadRaw pad;
+  uint16_t left_motor, right_motor;
+};
+using XInputGetStateFn = DWORD(WINAPI*)(DWORD, XInputStateRaw*);
+using XInputGetCapabilitiesFn = DWORD(WINAPI*)(DWORD, DWORD, XInputCapsRaw*);
+
+struct XInputCapsExRaw {
+  XInputCapsRaw caps;
+  uint16_t vendor, product, version, unknown1;
+  uint32_t unknown2;
+};
+using XInputGetCapabilitiesExFn = DWORD(WINAPI*)(DWORD, DWORD, DWORD, XInputCapsExRaw*);
+
+struct XInputApi {
+  XInputGetStateFn get_state = nullptr;
+  XInputGetCapabilitiesFn get_caps = nullptr;
+  XInputGetCapabilitiesExFn get_caps_ex = nullptr;  // ordinal 108, with VID and PID
+};
+
+const XInputApi& XInput() {
+  static const XInputApi api = [] {
+    XInputApi a;
+    if (HMODULE m = LoadLibraryW(L"xinput1_4.dll")) {
+      a.get_state = reinterpret_cast<XInputGetStateFn>(GetProcAddress(m, "XInputGetState"));
+      a.get_caps = reinterpret_cast<XInputGetCapabilitiesFn>(GetProcAddress(m, "XInputGetCapabilities"));
+      a.get_caps_ex = reinterpret_cast<XInputGetCapabilitiesExFn>(GetProcAddress(m, MAKEINTRESOURCEA(108)));
+    }
+    return a;
+  }();
+  return api;
+}
+
+// The guitar kind at an XInput slot; 0 when the slot holds no guitar.
+uint8_t XInputGuitarSubType(int user) {
+  if (user < 0 || user > 3 || !XInput().get_caps) return 0;
+  XInputCapsRaw caps{};
+  if (XInput().get_caps(DWORD(user), 0, &caps) != ERROR_SUCCESS) return 0;
+  return IsGuitarSubType(caps.sub_type) ? caps.sub_type : 0;
+}
+
+// The XInput slot of a device SDL opened, -1 when it has none. SDL opens a
+// wired Xbox 360 guitar through HIDAPI as a regular controller, so the slot is
+// the free one with the same vendor and product, the one SDL reports first.
+// taken: slots other devices already hold, one bit each.
+int XInputSlotOf(SDL_Gamepad* gamepad, uint32_t taken) {
+  auto is_free = [&](int user) { return user >= 0 && user < 4 && !(taken & (1u << user)); };
+  const int reported = SDL_GetGamepadPlayerIndex(gamepad);
+  const uint16_t vendor = SDL_GetGamepadVendor(gamepad), product = SDL_GetGamepadProduct(gamepad);
+  if (!XInput().get_caps_ex || (!vendor && !product)) return -1;
+  int found = -1;
+  for (int user = 0; user < 4; ++user) {
+    XInputCapsExRaw ex{};
+    if (!is_free(user) || XInput().get_caps_ex(1, DWORD(user), 0, &ex) != ERROR_SUCCESS) continue;
+    // What SDL does for the wireless Xbox 360 receiver, which reports no product.
+    if (ex.product == 0 && (ex.caps.flags & 0x0002)) {
+      ex.vendor = 0x045E;
+      ex.product = 0x028E;
+    }
+    if (ex.vendor != vendor || ex.product != product) continue;
+    if (user == reported) return user;
+    if (found < 0) found = user;
+  }
+  return found;
+}
+#endif
+
+// What each part of the guitar is on a regular controller (guitar_pad_*). The
+// layout and the names follow Piscacho's Guitar Hero: Warriors of Rock PC port
+// (gh6.ini's mando_*, MIT License, Copyright (c) 2026 Piscacho): Xbox names, the
+// PlayStation ones as aliases, several sources joined with "|", and the
+// triggers and stick directions as sources too.
+enum : uint32_t {
+  kSrcLT = 1u << 16,
+  kSrcRT = 1u << 17,
+  kSrcLsUp = 1u << 18,
+  kSrcLsDown = 1u << 19,
+  kSrcLsLeft = 1u << 20,
+  kSrcLsRight = 1u << 21,
+  kSrcRsUp = 1u << 22,
+  kSrcRsDown = 1u << 23,
+  kSrcRsLeft = 1u << 24,
+  kSrcRsRight = 1u << 25,
+  kSrcRsAny = X_INPUT_GAMEPAD_RIGHT_THUMB | kSrcRsUp | kSrcRsDown | kSrcRsLeft | kSrcRsRight,
+};
+
+uint32_t ParseSources(std::string_view text) {
+  static constexpr struct {
+    std::string_view name;
+    uint32_t bits;
+  } kNames[] = {
+      {"UP", X_INPUT_GAMEPAD_DPAD_UP},       {"DOWN", X_INPUT_GAMEPAD_DPAD_DOWN},
+      {"LEFT", X_INPUT_GAMEPAD_DPAD_LEFT},   {"RIGHT", X_INPUT_GAMEPAD_DPAD_RIGHT},
+      {"START", X_INPUT_GAMEPAD_START},      {"BACK", X_INPUT_GAMEPAD_BACK},
+      {"LS", X_INPUT_GAMEPAD_LEFT_THUMB},    {"RS", X_INPUT_GAMEPAD_RIGHT_THUMB},
+      {"LB", X_INPUT_GAMEPAD_LEFT_SHOULDER}, {"RB", X_INPUT_GAMEPAD_RIGHT_SHOULDER},
+      {"A", X_INPUT_GAMEPAD_A},              {"B", X_INPUT_GAMEPAD_B},
+      {"X", X_INPUT_GAMEPAD_X},              {"Y", X_INPUT_GAMEPAD_Y},
+      {"LT", kSrcLT},                        {"RT", kSrcRT},
+      {"LS_UP", kSrcLsUp},                   {"LS_DOWN", kSrcLsDown},
+      {"LS_LEFT", kSrcLsLeft},               {"LS_RIGHT", kSrcLsRight},
+      {"RS_UP", kSrcRsUp},                   {"RS_DOWN", kSrcRsDown},
+      {"RS_LEFT", kSrcRsLeft},               {"RS_RIGHT", kSrcRsRight},
+      {"CROSS", X_INPUT_GAMEPAD_A},          {"CIRCLE", X_INPUT_GAMEPAD_B},
+      {"SQUARE", X_INPUT_GAMEPAD_X},         {"TRIANGLE", X_INPUT_GAMEPAD_Y},
+      {"L1", X_INPUT_GAMEPAD_LEFT_SHOULDER}, {"R1", X_INPUT_GAMEPAD_RIGHT_SHOULDER},
+      {"L2", kSrcLT},                        {"R2", kSrcRT},
+      {"OPTIONS", X_INPUT_GAMEPAD_START},    {"CREATE", X_INPUT_GAMEPAD_BACK},
+      {"SHARE", X_INPUT_GAMEPAD_BACK},
+  };
+  uint32_t bits = 0;
+  size_t pos = 0;
+  while (pos <= text.size()) {
+    size_t end = text.find_first_of("|+, ", pos);
+    if (end == std::string_view::npos) end = text.size();
+    std::string token(text.substr(pos, end - pos));
+    for (char& c : token) c = static_cast<char>(std::toupper(static_cast<unsigned char>(c)));
+    for (const auto& n : kNames) {
+      if (token == n.name) bits |= n.bits;
+    }
+    pos = end + 1;
+  }
+  return bits;
+}
+
+// The controller's buttons, triggers and stick directions as source bits.
+uint32_t SourceBits(const X_INPUT_GAMEPAD& pad) {
+  constexpr int16_t kDeadZone = 16000;
+  const int16_t lx = pad.thumb_lx, ly = pad.thumb_ly, rx = pad.thumb_rx, ry = pad.thumb_ry;
+  uint32_t s = uint16_t(pad.buttons);
+  if (pad.left_trigger > 100) s |= kSrcLT;
+  if (pad.right_trigger > 100) s |= kSrcRT;
+  if (ly > kDeadZone) s |= kSrcLsUp;
+  if (ly < -kDeadZone) s |= kSrcLsDown;
+  if (lx < -kDeadZone) s |= kSrcLsLeft;
+  if (lx > kDeadZone) s |= kSrcLsRight;
+  if (ry > kDeadZone) s |= kSrcRsUp;
+  if (ry < -kDeadZone) s |= kSrcRsDown;
+  if (rx < -kDeadZone) s |= kSrcRsLeft;
+  if (rx > kDeadZone) s |= kSrcRsRight;
+  return s;
+}
+
+// A regular controller's state as an Xbox 360 guitar's: frets on A B Y X LB,
+// strum on the d-pad up and down, Star Power on Back, the whammy bar on the
+// right stick's X axis (-32768 at rest) and the tilt on its Y axis.
+X_INPUT_GAMEPAD PadToGuitar(const X_INPUT_GAMEPAD& pad) {
+  const struct {
+    const std::string& sources;
+    uint16_t guitar;
+  } kMap[] = {
+      {REXCVAR_GET(guitar_pad_green), X_INPUT_GAMEPAD_A},
+      {REXCVAR_GET(guitar_pad_red), X_INPUT_GAMEPAD_B},
+      {REXCVAR_GET(guitar_pad_yellow), X_INPUT_GAMEPAD_Y},
+      {REXCVAR_GET(guitar_pad_blue), X_INPUT_GAMEPAD_X},
+      {REXCVAR_GET(guitar_pad_orange), X_INPUT_GAMEPAD_LEFT_SHOULDER},
+      {REXCVAR_GET(guitar_pad_strum_up), X_INPUT_GAMEPAD_DPAD_UP},
+      {REXCVAR_GET(guitar_pad_strum_down), X_INPUT_GAMEPAD_DPAD_DOWN},
+      {REXCVAR_GET(guitar_pad_left), X_INPUT_GAMEPAD_DPAD_LEFT},
+      {REXCVAR_GET(guitar_pad_right), X_INPUT_GAMEPAD_DPAD_RIGHT},
+      {REXCVAR_GET(guitar_pad_start), X_INPUT_GAMEPAD_START},
+      {REXCVAR_GET(guitar_pad_star_power), X_INPUT_GAMEPAD_BACK},
+  };
+  const uint32_t s = SourceBits(pad);
+  uint16_t buttons = 0;
+  for (const auto& m : kMap) {
+    if (s & ParseSources(m.sources)) buttons |= m.guitar;
+  }
+
+  const uint32_t whammy = ParseSources(REXCVAR_GET(guitar_pad_whammy));
+  int depth = 0;  // 0..255
+  if (whammy & kSrcRT) depth = std::max<int>(depth, pad.right_trigger);
+  if (whammy & kSrcLT) depth = std::max<int>(depth, pad.left_trigger);
+  if (whammy & kSrcRsAny) {
+    const int16_t rx = pad.thumb_rx, ry = pad.thumb_ry;
+    depth = std::max(depth, std::min(255, std::max(std::abs(int(rx)), std::abs(int(ry))) >> 7));
+  }
+  const uint32_t tilt = ParseSources(REXCVAR_GET(guitar_pad_tilt));
+
+  X_INPUT_GAMEPAD out{};
+  out.buttons = buttons;
+  out.thumb_rx = static_cast<int16_t>(std::clamp(-32768 + depth * 257, -32768, 32767));
+  out.thumb_ry = static_cast<int16_t>((tilt && (s & tilt)) ? 32767 : 0);
+  return out;
+}
