diff --git a/include/rex/input/guitar.h b/include/rex/input/guitar.h
new file mode 100644
index 0000000..73d0034
--- /dev/null
+++ b/include/rex/input/guitar.h
@@ -0,0 +1,22 @@
+#pragma once
+
+#include <cstdint>
+
+// Regular controllers and the keyboard playing as a guitar (gamepad_as_guitar).
+namespace rex::input {
+
+// Called by the game on every frame of a song (a hook on the game's own
+// per-player update in a song). Auto-strum only acts while these are recent:
+// the menus move their cursor with the d-pad, so a strum on every fret would
+// move it each time the green fret confirms.
+void MarkSongFrame();
+bool InSong();
+
+// Auto-strum (guitar_autostrum): each fret pressed also strums, GH2 / GH3
+// style, so a regular controller or the keyboard can play with the frets
+// alone. Frets pressed within a few milliseconds of each other make one chord.
+// `device` tells the players apart; `buttons` are the guitar's buttons for
+// this read, and the d-pad down of a strum is added to them.
+uint16_t AutoStrum(const void* device, uint16_t buttons);
+
+}  // namespace rex::input
