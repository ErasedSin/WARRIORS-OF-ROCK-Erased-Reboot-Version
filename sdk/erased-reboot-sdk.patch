+void KernelState::UnlockAchievementForUser(uint32_t user_index, uint32_t id) {
+  xam::UserProfile* profile = user_index >= 1 && user_index < 4 ? user_profile(user_index) : nullptr;
+  const auto user_root = emulator_->user_data_root();
+  if (!profile || profile == user_profile_.get() || profile->xuid() == 0 || user_root.empty()) {
+    UnlockAchievement(id);
+    return;
+  }
+  const std::filesystem::path path = user_root / "achievements" / fmt::format("{:016X}", profile->xuid()) /
+                                     fmt::format("{:08X}.toml", title_id());
+  std::map<uint32_t, uint64_t> unlocked;
+  std::error_code ec;
+  if (std::filesystem::exists(path, ec)) {
+    try {
+      auto table = toml::parse_file(path.string());
+      if (auto* entries = table["unlocked"].as_table()) {
+        for (const auto& [key, value] : *entries) {
+          const uint32_t entry_id = uint32_t(std::strtoul(std::string(key.str()).c_str(), nullptr, 10));
+          int64_t filetime = 0;
+          if (auto* fields = value.as_table()) filetime = (*fields)["filetime"].value_or<int64_t>(0);
+          unlocked[entry_id] = uint64_t(filetime);
+        }
+      }
+    } catch (const toml::parse_error& error) {
+      REXSYS_WARN("Achievements: cannot read {}: {}", path.string(), error.what());
+    }
+  }
+  if (unlocked.count(id)) {
+    return;
+  }
+  unlocked[id] = AchievementManager::CurrentFileTime();
+  std::string content = "# Achievement unlock state - managed by ReXGlue runtime\n\n";
+  for (const auto& [entry_id, filetime] : unlocked) {
+    content += fmt::format("[unlocked.{}]\nfiletime = {}\n\n", entry_id, filetime);
+  }
+  std::filesystem::create_directories(path.parent_path(), ec);
+  std::ofstream(path, std::ios::binary | std::ios::trunc) << content;
+  REXSYS_INFO("Achievements: {} earned by player {} ({})", id, user_index + 1, profile->name());
+  achievement_manager_.ShowAchievementNotification(id);
+}
