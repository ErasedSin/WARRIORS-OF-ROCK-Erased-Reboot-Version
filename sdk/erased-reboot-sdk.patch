+  // The profile of user_index: with player_profiles, that player's own when
+  // they have one; otherwise player 1's (whose IsSignedIn tells the rest).
+  xam::UserProfile* user_profile(uint32_t user_index) const {
+    if (user_index >= 1 && user_index < 4 && player_profiles_[user_index]) {
