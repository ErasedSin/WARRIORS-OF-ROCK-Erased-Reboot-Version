+struct PlayerDevice {
+  Kind kind = Kind::kAuto;
+  uint32_t number = 1;  // the nth device of that kind, from 1; kXInput: the slot, from 1
+  uint16_t vendor = 0, product = 0;  // kHid
+  bool sdl = false;                  // kXInput: read through SDL rather than raw XInput
+};
+
+PlayerDevice ParsePlayerDevice(std::string text) {
+  for (auto& c : text) c = char(std::tolower(static_cast<unsigned char>(c)));
+  PlayerDevice out;
+  if (text.rfind("hid:", 0) == 0) {
+    unsigned vendor = 0, product = 0, number = 1;
+    const int read = std::sscanf(text.c_str() + 4, "%x:%x:%u", &vendor, &product, &number);
+    if (read >= 2) {
+      out.kind = Kind::kHid;
+      out.vendor = uint16_t(vendor);
+      out.product = uint16_t(product);
+      out.number = std::max(1u, number);
+    }
+    return out;
+  }
+  const size_t suffix = text.find(":sdl");
+  if (suffix != std::string::npos) {
+    out.sdl = true;
+    text.resize(suffix);
+  }
+  size_t digits = text.size();
+  while (digits > 0 && std::isdigit(static_cast<unsigned char>(text[digits - 1]))) --digits;
+  if (digits < text.size()) {
+    out.number = uint32_t(std::max(1, std::atoi(text.c_str() + digits)));
+    text.resize(digits);
+  }
+  if (text == "none") out.kind = Kind::kNone;
+  else if (text == "keyboard") out.kind = Kind::kKeyboard;
+  else if (text == "guitar") out.kind = Kind::kGuitar;
+  else if (text == "gamepad" || text == "controller") out.kind = Kind::kGamepad;
+  else if (text == "drums") out.kind = Kind::kDrums;
+  else if (text == "xinput") out.kind = Kind::kXInput;
+  return out;
