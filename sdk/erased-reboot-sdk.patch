+void rc_runtime_deactivate_lboard(rc_runtime_t* self, uint32_t id) {
+  uint32_t i;
+
+  for (i = 0; i < self->lboard_count; ++i) {
+    if (self->lboards[i].id == id && self->lboards[i].lboard != NULL)
+      rc_runtime_deactivate_lboard_by_index(self, i);
+  }
+}
