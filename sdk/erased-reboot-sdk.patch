+// Auto-strum for regular controllers and the keyboard playing as a guitar.
+// The idea (a strum on each fret pressed, only while a song runs) follows
+// GHVanHRecomp's src/keyboard.cpp (MIT License, Copyright (c) 2026 Gustavo
+// Garcia).
+
+#include <rex/input/guitar.h>
+
+#include <rex/cvar.h>
+#include <rex/input/input.h>
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <mutex>
+#include <unordered_map>
+
+REXCVAR_DEFINE_BOOL(guitar_autostrum, true, "Input/Guitar",
+                    "Regular controller or keyboard as a guitar: each fret pressed also strums, only during a song "
+                    "(the menus keep the frets as buttons). The strum buttons still work.");
+REXCVAR_DEFINE_INT32(guitar_autostrum_chord_ms, 25, "Input/Guitar",
+                     "Auto-strum: frets pressed within this many milliseconds of each other make one chord");
+
+namespace rex::input {
+
+namespace {
+
+using Clock = std::chrono::steady_clock;
+
+std::atomic<int64_t> g_song_frame{0};
+
+constexpr uint16_t kFrets = X_INPUT_GAMEPAD_A | X_INPUT_GAMEPAD_B | X_INPUT_GAMEPAD_X | X_INPUT_GAMEPAD_Y |
+                            X_INPUT_GAMEPAD_LEFT_SHOULDER;
+
+// A strum holds the d-pad down this long, two frames at 60 FPS so the game sees
+// it, and then lets it go for at least as long before the next one, so the next
+// is a new press.
+constexpr auto kStrumHold = std::chrono::milliseconds(34);
+constexpr auto kStrumGap = std::chrono::milliseconds(20);
+
+struct State {
+  uint16_t frets = 0;
+  Clock::time_point strum_start;
+  Clock::time_point strum_end;
+  bool pending = false;  // a fret was pressed while the previous strum or its gap ran
+};
+
+std::mutex g_mutex;
+std::unordered_map<const void*, State> g_states;
+
+}  // namespace
+
+void MarkSongFrame() {
+  g_song_frame.store(Clock::now().time_since_epoch().count(), std::memory_order_relaxed);
+}
+
+bool InSong() {
+  const int64_t last = g_song_frame.load(std::memory_order_relaxed);
+  // A song's frames come at least 20 times a second; a quarter of a second
+  // without one is the menus or the pause menu.
+  return last != 0 && Clock::now().time_since_epoch().count() - last <
+                          std::chrono::duration_cast<Clock::duration>(std::chrono::milliseconds(250)).count();
+}
+
+uint16_t AutoStrum(const void* device, uint16_t buttons) {
+  if (!REXCVAR_GET(guitar_autostrum)) {
+    return buttons;
+  }
+  std::lock_guard lock(g_mutex);
+  State& s = g_states[device];
+  const uint16_t frets = buttons & kFrets;
+  const uint16_t pressed = frets & ~s.frets;
+  s.frets = frets;
+  if (!InSong()) {
+    s.pending = false;
+    s.strum_end = {};
+    return buttons;
+  }
+
+  const Clock::time_point now = Clock::now();
+  const auto chord = std::chrono::milliseconds(std::max(0, REXCVAR_GET(guitar_autostrum_chord_ms)));
+  if (pressed) {
+    if (now < s.strum_end && now - s.strum_start < chord) {
+      // Part of the chord being strummed.
+    } else {
+      s.pending = true;
+    }
+  }
+  if (s.pending && now >= s.strum_end + kStrumGap) {
+    s.pending = false;
+    s.strum_start = now;
+    s.strum_end = now + kStrumHold;
+  }
+  if (now < s.strum_end) {
+    buttons |= X_INPUT_GAMEPAD_DPAD_DOWN;
+  }
+  return buttons;
+}
+
+}  // namespace rex::input
