+
+Kind DeviceKind(const DeviceInfo& device) {
+  if (device.keyboard) return Kind::kKeyboard;
+  switch (device.native_subtype) {
+    case 0x06:  // XINPUT_DEVSUBTYPE_GUITAR
+    case 0x07:  // XINPUT_DEVSUBTYPE_GUITAR_ALTERNATE
+    case 0x0B:  // XINPUT_DEVSUBTYPE_GUITAR_BASS
+      return Kind::kGuitar;
+    case 0x08:  // XINPUT_DEVSUBTYPE_DRUM_KIT
+      return Kind::kDrums;
+    default:
+      return device.synthetic ? Kind::kNone : Kind::kGamepad;
+  }
+}
+
+}  // namespace
+
+bool PlayersNeedXInputDriver() {
+#if REX_PLATFORM_WIN32
+  if (DefaultIsXInput()) return true;
+  for (const auto& player : Players()) {
+    if (player.kind == Kind::kXInput && !player.sdl) return true;
+  }
+#endif
+  return false;
+}
+
+// With XInput as the default reading, SDL still reads the controllers XInput
+// does not see (PlayStation and other pads), for the players who chose one or
+// left the choice to the game.
+bool PlayersNeedSdlDriver() {
+  if (!DefaultIsXInput()) return true;
+  for (const auto& player : Players()) {
+    switch (player.kind) {
+      case Kind::kNone:
+      case Kind::kKeyboard:
+        break;
+      case Kind::kXInput:
+        if (player.sdl) return true;
+        break;
+      default:
+        return true;
+    }
+  }
+  return false;
