+struct PlayerDevice {
+  Kind kind = Kind::kAuto;
+  uint32_t number = 1;  // the nth device of that kind, from 1; kXInput: the slot, from 1
+  uint16_t vendor = 0, product = 0;  // kHid
+  bool sdl = false;                  // kXInput: read through SDL rather than raw XInput
+};
+
+PlayerDevice ParsePlayerDevice(std::string text) {
+  for (auto& c : text) c = char(std::tolower(static_cast<unsigned char>(c)));
+  PlayerDevice out;
+  if (text.rfind("hid:", 0) == 0) {
+    unsigned vendor = 0, product = 0, number = 1;
+    const int read = std::sscanf(text.c_str() + 4, "%x:%x:%u", &vendor, &product, &number);
