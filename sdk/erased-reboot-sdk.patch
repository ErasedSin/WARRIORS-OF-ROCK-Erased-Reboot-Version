+// (input_backend); the other copy is left out.
+bool OtherReading(const DeviceInfo& device) {
+  if (device.synthetic) return false;
+  if (DefaultIsXInput()) return !device.raw_xinput && device.xinput_slot >= 0;
+  return device.raw_xinput;
